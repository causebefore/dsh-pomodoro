{
  "name": "dsh-pomodoro",
  "description": "A DeepSeek Harness Web Pomodoro plugin with configurable focus and break intervals, sidebar access, and a draggable floating panel",
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/causebefore/dsh-pomodoro.git"
  },
  "bugs": {
    "url": "https://github.com/causebefore/dsh-pomodoro/issues"
  },
  "homepage": "https://github.com/causebefore/dsh-pomodoro#readme",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "pomodoro",
    "productivity",
    "timer"
  ],
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test test/runtime-persistence.test.mjs test/slot-registration.test.mjs test/index-rpc.test.mjs test/panel-position.test.mjs test/settings-scope.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && npm test",
    "prepublishOnly": "npm run check"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.7 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.7 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.7 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.7 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.0-rc.7 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7 || ^0.1.1-rc.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.zh.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT"
}
